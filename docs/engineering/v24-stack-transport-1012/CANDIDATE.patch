+     expression="%json "+JSON.stringify(clean)+" | JSON_SURROGATE_STRING_MIN2";
+    }else expression="%json "+JSON.stringify(clean)+" | JSON_SURROGATE_STRING";
+   } else expression="%json "+JSON.stringify(clean);
+  }
+  rules.set(id,expression);return id;
+ }
+ if(schema.type!=="object")fail("ROOT");
+ const root=build(schema);
+ const grammar="start: "+root+"\n"+[...rules].map(([n,e])=>n+": "+e).join("\n");
+ check();if(grammar.length>60000||rules.size>10000)fail("COMPILE_LIMIT");
+ return Object.freeze({grammar,ruleCount:rules.size,visits});
+}
+
+
+/** Experimental transport only. No application dispatch path uses this module. */
+export function createTypedGrammarAskWirePlan(plan, providerTypedSchema, checkCompilation) {
+ if (typeof checkCompilation !== "function") reject("DEADLINE_REQUIRED");
+ checkCompilation(); safeEnvironment();
+ const schema = plainCopy(providerTypedSchema, checkCompilation);
+ const expanded = expand(schema, checkCompilation), valid = makeValidator(expanded, checkCompilation);
+ const { grammar, ruleCount } = compileTypedJsonGrammar(schema, checkCompilation);
+ const recursive = createRecursiveAskWirePlan(plan, checkCompilation);
+ const lines = recursive.instructions.split("\n");
+ if (!lines[0].includes("root: required request wrapper;") || !/^ROOT root\.[A-Za-z]+ embeds the complete request node\. No nodes array\.$/.test(lines[1]))
+  reject("POLICY_LAYOUT");
+ const instructions = [
+  lines[0].replace("root: required request wrapper;", "JSON object: required request wrapper;"),
+  lines[1].replace("ROOT root.", "ROOT ").replace(" No nodes array.", " No outer root or nodes property."),
+  "Submit exactly one furvise_ask_plan custom tool call containing the complete typed JSON object. This supplies a proposal only; it executes no action.",
+  ...lines.slice(2),
+ ].join("\n");
+ function ordered(s, value, check) {
+  check();
+  if (s.anyOf) {
+   const arm = s.anyOf.find(a => valid(a, value));
+   if (!arm) reject("TYPED_SCHEMA");
+   return ordered(arm, value, check);
+  }
+  if (value === null || typeof value !== "object") return value;
+  if (Array.isArray(value)) return value.map(v => ordered(s.items, v, check));
+  return Object.fromEntries(Object.keys(s.properties).map(k => [k, ordered(s.properties[k], value[k], check)]));
+ }
+ return Object.freeze({
+  grammar, ruleCount, instructions,
+  tool: Object.freeze({type:"custom", name:"furvise_ask_plan",
+   description:"Propose the whole governed request as typed JSON. This supplies data only and does not execute actions.",
+   format:Object.freeze({type:"grammar",syntax:"lark",definition:grammar})}),
+  encode(value, check) {
+   const clean = plainCopy(value, check);
+   const root = recursive.encode(clean, check).root;
+   if (!valid(expanded, root)) reject("TYPED_SCHEMA");
+   return ordered(expanded, root, check);
+  },
+  decode(value, check) {
+   const clean = plainCopy(value, check);
+   if (!valid(expanded, clean)) reject("TYPED_SCHEMA");
+   check();
+   return recursive.decode({root:clean}, check);
+  },
+ });
+}
