+   if(types.includes("null"))expression="("+expression+") | "+literal("null");
+  }else if(types.includes("array")){
+   if(types.some(t=>t!=="array"&&t!=="null")||Object.keys(clean).some(k=>!["type","items","minItems","maxItems"].includes(k)))fail("ARRAY_CONSTRAINT");
+   const lo=n.minItems??0,hi=n.maxItems;
+   if(!Number.isInteger(lo)||lo<0||(hi!==undefined&&(!Number.isInteger(hi)||hi<lo||hi>4096)))fail("ARRAY_LIMIT");
+   if(hi===0)expression=literal("[]");
+   else {const item=build(n.items),tail=hi===1?"":' ("," '+item+')~'+Math.max(0,lo-1)+".."+(hi===undefined?"":hi-1);
+    const contents=item+tail;expression=literal("[")+" "+(lo===0?"("+contents+")?":contents)+" "+literal("]");}
+  if(types.includes("null"))expression="("+expression+") | "+literal("null");
+  }else {
+   if(types.some(t=>!["string","integer","number","boolean","null"].includes(t)))fail("PRIMITIVE_TYPE");
+   if(Object.keys(clean).some(k=>["properties","required","additionalProperties","items","minItems","maxItems"].includes(k)))fail("PRIMITIVE_CONSTRAINT");
+   if(types.includes("string") && !n.enum && !n.pattern) {
+    if(types.some(t=>t!=="string"&&t!=="null")||Object.keys(clean).some(k=>!["type","minLength","maxLength"].includes(k)))fail("STRING_CONSTRAINT");
