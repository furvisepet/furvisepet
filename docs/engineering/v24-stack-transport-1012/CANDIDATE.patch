--- /dev/null
+++ b/app/lib/intelligence/ask-wire-typed-grammar.mjs
@@ -0,0 +1,187 @@
+import { types as nodeTypes } from "node:util";
+
+import { expand, makeValidator } from "./ask-wire-codec.mjs";
+import { createRecursiveAskWirePlan, RECURSIVE_TRANSPORT_LIMITS } from "./ask-wire-recursive.mjs";
+
+const reject = code => { throw Error("ASK_TYPED_GRAMMAR_" + code); };
+const objectPrototypeNames = new Set(["constructor", "__defineGetter__", "__defineSetter__", "hasOwnProperty",
+ "__lookupGetter__", "__lookupSetter__", "isPrototypeOf", "propertyIsEnumerable", "toString", "valueOf", "__proto__", "toLocaleString"]);
+function safeEnvironment() {
+ // Refuse ambient prototype hooks before invoking legacy schema utilities.
+ if (Reflect.ownKeys(Object.prototype).some(k => !objectPrototypeNames.has(k))
+   || Object.getOwnPropertyDescriptor(Array.prototype, "toJSON")
+   || Reflect.ownKeys(Array.prototype).some(k => typeof k === "string" && /^(0|[1-9]\d*)$/.test(k)))
+   reject("ENVIRONMENT");
+}
+function plainCopy(value, check) {
+ if (typeof check !== "function") reject("DEADLINE_REQUIRED");
+ check(); safeEnvironment();
+ const lim = RECURSIVE_TRANSPORT_LIMITS, seen = new WeakSet();
+ let values = 0, containers = 0, chars = 0;
+ const charge = n => { chars += n; if (chars > lim.maxSerializedCharacters) reject("SERIALIZED_LIMIT"); };
+ function walk(v, depth) {
+  if (v !== null && typeof v === "object" && nodeTypes.isProxy(v)) reject("NON_JSON_TREE");
+  check();
+  if (depth > lim.maxDepth || ++values > lim.maxValues) reject("RESOURCE_LIMIT");
+  if (v === null || typeof v === "boolean" || typeof v === "number" && Number.isFinite(v)) {
+   charge(JSON.stringify(v).length); return v;
+  }
+  if (typeof v === "string") {
+   if (v.length > lim.maxStringUnits) reject("STRING_LIMIT");
+   charge(JSON.stringify(v).length); return v;
+  }
+  if (v === null || typeof v !== "object" || seen.has(v)) reject("NON_JSON_TREE");
+  seen.add(v);
+  if (++containers > lim.maxContainers) reject("RESOURCE_LIMIT");
+  const array = Array.isArray(v), proto = Object.getPrototypeOf(v);
+  if (array ? proto !== Array.prototype : proto !== Object.prototype && proto !== null) reject("PLAIN_CONTAINER");
+  if (Object.getOwnPropertyDescriptor(v, "toJSON")) reject("OWN_DATA_PROPERTY");
+  let length = 0;
+  if (array) {
+   const d = Object.getOwnPropertyDescriptor(v, "length");
+   if (!d || !Object.hasOwn(d, "value") || !Number.isSafeInteger(d.value) || d.value < 0) reject("ARRAY_SHAPE");
+   length = d.value;
+   if (length > Math.min(lim.maxContainerEntries, lim.maxValues - values)) reject("RESOURCE_LIMIT");
+  }
+  const keys = Reflect.ownKeys(v);
+  if (keys.length > lim.maxContainerEntries + (array ? 1 : 0)) reject("RESOURCE_LIMIT");
+  if (array && (keys.length !== length + 1 || keys.some(k => k !== "length"
+    && (typeof k !== "string" || !/^(0|[1-9]\d*)$/.test(k) || Number(k) >= length)))) reject("ARRAY_SHAPE");
+  const result = array ? [] : Object.create(null);
+  charge(2);
+  let entries = 0;
+  for (const k of keys) {
+   if (array && k === "length") continue;
+   if (typeof k !== "string") reject("OWN_DATA_PROPERTY");
+   const d = Object.getOwnPropertyDescriptor(v, k);
+   if (!d || !Object.hasOwn(d, "value") || !d.enumerable) reject("OWN_DATA_PROPERTY");
+   if (entries++) charge(1);
+   if (!array) charge(JSON.stringify(k).length + 1);
+   Object.defineProperty(result, k, { value: walk(d.value, depth + 1), enumerable: true, writable: true, configurable: true });
+  }
+  return result;
+ }
+ const result = walk(value, 0); check(); return result;
+}
+
+// Experimental provider grammar compiler. Not connected to application transport.
+// Object/array/union structure comes only from the compiled canonical schema.
+// Primitive constraints remain typed primitive grammars; no JSON-in-string fields.
+export function compileTypedJsonGrammar(schema, check = () => {}) {
+ const fail = c => { throw Error("ASK_TYPED_GRAMMAR_"+c); };
+ check();
+ schema=plainCopy(schema,check);
+ const defs=schema.$defs??{}, memo=new Map(), rules=new Map(), active=new Set();
+ const allowed=new Set(["type","properties","required","additionalProperties","anyOf","items","enum","minItems","maxItems","minLength","maxLength","minimum","maximum","pattern","$ref","$defs"]);
+ const literal=JSON.stringify;
+ const regexMeta=new Set(".*+?^$"+"{}()|[]\\/");
+ const keyLiteral=k=>"/"+[...(JSON.stringify(k)+":")].map(c=>regexMeta.has(c)?"\\"+c:c).join("")+"/";
+ let visits=0;
+ function build(n){
+  check();if(++visits>100000)fail("COMPILE_LIMIT");
+  if(!n||typeof n!=="object"||Array.isArray(n))fail("SCHEMA");
+  if(Object.keys(n).some(k=>!allowed.has(k)))fail("KEYWORD");
