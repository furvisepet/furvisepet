+   const keys=Object.keys(n.properties);
+   if(JSON.stringify([...keys].sort())!==JSON.stringify([...n.required].sort()))fail("REQUIRED");
+   if(Object.keys(clean).some(k=>!["type","additionalProperties","properties","required"].includes(k)))fail("OBJECT_CONSTRAINT");
