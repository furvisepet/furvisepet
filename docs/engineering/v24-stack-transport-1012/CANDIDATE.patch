+  canonical(schema.required.slice().sort()) === canonical(["nodes", "root"]), "ENVELOPE_SCHEMA");
+ const expanded = expand(schema, checkCompilation), valid = makeValidator(expanded, checkCompilation);
+ const [header, rootLine, ...unchanged] = plan.instructions.split("\n");
+ const layout = 'nodes: supporting postorder tree; root: required request wrapper after nodes; child objects {"@":index} refer to earlier nodes. No shared/unused/forward/cyclic nodes.';
+ ensure(header.split(layout).length === 2 &&
+  /^ROOT root\.[A-Za-z]+ references the complete request node in nodes\. Omit the wrapper from nodes; root has implicit index nodes\.length\.$/.test(rootLine), "POLICY_LAYOUT");
+ const rootAlias = rootLine.split(" ")[1];
+ const instructions = [
+  header.replace(layout, 'nodes: typed supporting nodes in postorder; root: required request wrapper after nodes. Each {"take":true} consumes one completed child tree; no indices.'),
+  "ROOT " + rootAlias + ' consumes the complete request tree using {"take":true}. Omit this wrapper from nodes.',
+  "STACK For each node, consume its completed children from the end of the stack in original field-alias alphabetical order (ignore ~tag suffix), then array order; push the completed parent. Emit children before their parent in that same order. Every child is used once. Exactly one complete tree must remain after root. A marker is structural only; never infer absent fields or semantics.",
+  ...unchanged,
+ ].join("\n");
+ function toGraph(value, check) {
+  const clean = plainCopy(value, check);
+  ensure(valid(expanded, clean), "PROVIDER_SCHEMA"); check();
+  const nodes = [], stack = [];
+  for (const input of [...clean.nodes, clean.root]) {
+   check(); let arity = 0;
+   function count(v) {
+    check();
+    if (Array.isArray(v)) { v.forEach(count); return; }
+    if (object(v)) {
+     ensure(Object.keys(v).length === 1 && Object.hasOwn(v,"take") && v.take === true, "MARKER");
+     arity++;
+    }
+   }
+   for (const k of keysInGraphOrder(input)) count(input[k]);
+   ensure(arity <= stack.length, "UNDERFLOW");
+   const children = arity ? stack.splice(stack.length - arity, arity) : [];
+   let cursor = 0;
+   function link(v) {
+    check();
+    if (Array.isArray(v)) return v.map(link);
+    return object(v) ? { "@": children[cursor++] } : v;
+   }
+   const node = Object.fromEntries(keysInGraphOrder(input).map(k => [k, link(input[k])]));
+   ensure(cursor === children.length && nodes.length < RECURSIVE_TRANSPORT_LIMITS.maxContainers, "RESOURCE_LIMIT");
+   stack.push(nodes.length); nodes.push(node);
+  }
+  ensure(stack.length === 1 && stack[0] === nodes.length - 1, "UNUSED_TREES");
+  check();
+  return { nodes: nodes.slice(0,-1), root: nodes.at(-1) };
+ }
+ function decode(value, check) {
+  const graph = toGraph(value, check);
+  check(); const result = plan.decode(graph); check(); return result;
+ }
+ return Object.freeze({
+  schema, instructions: compactPolicy(instructions, checkCompilation), uncompressedInstructions: instructions, edgeSchemaCount: edges,
+  decode,
+  encode(value, check) {
+   const clean = plainCopy(value, check);
+   const graph = plan.encode(clean); check();
+   function replace(v) {
+    check();
+    if (Array.isArray(v)) return v.map(replace);
+    if (object(v)) {
+     ensure(Object.keys(v).length === 1 && Object.hasOwn(v,"@") && Number.isSafeInteger(v["@"]), "INDEXED_EDGE");
+     return marker();
+    }
+    return v;
+   }
+   const convert = n => Object.fromEntries(keysInGraphOrder(n).map(k => [k,replace(n[k])]));
+   const encoded = { nodes: graph.nodes.map(convert), root: convert(graph.root) };
+   // Prove that structural stack reconstruction preserved every original edge.
+   ensure(canonical(toGraph(encoded, check)) === canonical(graph), "NONCANONICAL_STACK");
+   plan.decode(graph); check(); return encoded;
+  },
+ });
+}
