+  .sort(([a,ac],[b,bc]) => score(b,bc) - score(a,ac) || compare(a,b));
+ const dictionary = [], aliases = new Map();
+ for (const [word,count] of words) {
+  check(); const alias = "~" + symbol(dictionary.length);
+  if ((word.length - alias.length) * count > word.length + alias.length + 2) {
