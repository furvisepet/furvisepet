+    if(!Number.isSafeInteger(lo)||lo<0||hi!==undefined&&(!Number.isSafeInteger(hi)||hi<lo||hi>65536))fail("STRING_LIMIT");
+   }
+   // Preserve lone UTF-16 surrogate escapes without grammar intersections.
+   // Strict decoder still enforces all string length and value constraints.
+   if(types.includes("string")&&!n.enum&&!n.pattern){
+    const unit=String.raw`(?:[^"\\\x00-\x1F]|\\(?:["\\\/bfnrt]|u[0-9a-fA-F]{4}))`;
+    const surrogate=String.raw`\\u[dD][89aAbB][0-9a-fA-F]{2}|\\u[dD][cCdDeEfF][0-9a-fA-F]{2}`;
+    rules.set("JSON_SURROGATE_STRING",'/'+String.raw`"`+unit+"*(?:"+surrogate+")"+unit+"*"+String.raw`"`+'/');
+    if((n.minLength??0)>=2){
+     // A sole escaped surrogate is one UTF-16 unit and cannot satisfy minLength >=2.
+     // Two lexical units suffice as a safe lower bound; strict decoding checks length.
+     const fragment="(?:"+unit+"+(?:"+surrogate+")"+unit+"*|"+unit+"*(?:"+surrogate+")"+unit+"+)";
