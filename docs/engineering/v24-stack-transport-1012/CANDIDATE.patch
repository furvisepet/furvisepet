+}
+
+/**
+ * Experimental, non-recursive Structured Outputs transport. A marker explicitly
+ * consumes one completed child tree. It never names a node, chooses an operation,
+ * supplies a default or derives meaning from source prose.
+ *
+ * The exact compiled node union supplies every scalar/array/tag schema. A
+ * deterministic postorder stack rebuilds indices. The original plan decoder
+ * checks parent/child types, root, depth, canonical order and all semantics.
+ * Application dispatch deliberately remains unchanged until hosted qualification.
+ */
+export function createStackAskWirePlan(plan, checkCompilation) {
+ ensure(typeof checkCompilation === "function", "DEADLINE_REQUIRED");
+ checkCompilation(); safeEnvironment();
+ const compiled = plainCopy(plan.schema, checkCompilation);
+ let edges = 0;
+ function transform(n) {
+  checkCompilation();
