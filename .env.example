# Public browser configuration (publishable values only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SENTRY_DSN=

# Stripe Billing (server only). Configure one recurring monthly Price with fixed
# CAD 5.49 and USD 5.49 currency options; never prefix these with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLUS_PRICE_ID=
# Server-only fallback used only when trusted platform geolocation is unavailable.
# This controls Membership price presentation, never Stripe Checkout currency.
FURVISE_BILLING_DISPLAY_MARKET=CA

# Shop catalogue selection. PRODUCT_PROVIDER is authoritative on the server;
# the public value only selects the matching browser flow. Account country wins
# over these defaults. CA and US are the only supported product markets.
PRODUCT_PROVIDER=catalog
NEXT_PUBLIC_PRODUCT_PROVIDER=catalog
PRODUCT_COUNTRY=CA
NEXT_PUBLIC_PRODUCT_COUNTRY=CA

# Furvise S2B distributed rate limiting (server only; never prefix with NEXT_PUBLIC_)
FURVISE_RATE_LIMIT_ENABLED=true
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-a-dedicated-environment-token
FURVISE_RATE_LIMIT_HASH_SECRET=replace-with-at-least-32-random-characters
FURVISE_RATE_LIMIT_TIMEOUT_MS=800

# Furvise S2G Auth abuse controls. The site key is public; the secret is server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
FURVISE_AUTH_RATE_LIMIT_HASH_SECRET=replace-with-a-separate-at-least-32-character-random-secret
# Use "always" only when the Supabase project requires CAPTCHA on every password sign-in.
FURVISE_AUTH_LOGIN_CAPTCHA_MODE=progressive
# Development only; production ignores this even if set true.
FURVISE_CAPTCHA_DEV_BYPASS=false
FURVISE_OPERATIONS_HASH_SECRET=replace-with-a-separate-at-least-32-character-random-secret
FURVISE_READINESS_SECRET=replace-with-a-separate-at-least-32-character-random-secret

# Optional bounded overrides (1 to five times the compiled default)
# FURVISE_RATE_LIMIT_ASK_AI_USER_PER_MINUTE=10
# FURVISE_RATE_LIMIT_ASK_AI_IP_PER_MINUTE=30
# FURVISE_RATE_LIMIT_VET_BRIEF_AI_USER_PER_MINUTE=4
# FURVISE_RATE_LIMIT_VET_BRIEF_AI_IP_PER_MINUTE=12
# FURVISE_RATE_LIMIT_AUTH_SIGNUP_IP_LIMIT=5
# FURVISE_RATE_LIMIT_AUTH_SIGNUP_EMAIL_LIMIT=3
# FURVISE_RATE_LIMIT_AUTH_LOGIN_IP_LIMIT=20
# FURVISE_RATE_LIMIT_AUTH_LOGIN_EMAIL_LIMIT=10

# Furvise S2C AI admission and spending controls (server only)
FURVISE_AI_ENABLED=true
FURVISE_AI_ASK_ENABLED=true
FURVISE_AI_CARE_PLAN_ENABLED=true
FURVISE_AI_PRODUCTS_ENABLED=true
FURVISE_AI_SAFETY_FOLLOWUP_ENABLED=true
FURVISE_AI_VET_BRIEF_ENABLED=true
FURVISE_AI_MEMORY_EXTRACTION_ENABLED=true

# Production values require operator confirmation; requests fail closed when absent.
FURVISE_AI_DAILY_CALL_LIMIT=
FURVISE_AI_DAILY_COST_LIMIT_USD=

# Development-only escape hatches; never enable in preview or production.
# FURVISE_AI_ALLOW_UNKNOWN_MODEL_IN_DEVELOPMENT=false
# FURVISE_AI_ALLOW_UNGUARDED_PROVIDER_IN_DEVELOPMENT=false

# Furvise S2D browser security policy (server-side configuration)
FURVISE_CSP_MODE=report-only
FURVISE_CSP_REPORT_URI=
FURVISE_ALLOWED_ORIGINS=https://www.furvise.com
FURVISE_ALLOWED_IMAGE_ORIGINS=
FURVISE_ALLOWED_CONNECT_ORIGINS=
# Local-only, ignored in production. Use exact origins including ports.
FURVISE_ALLOWED_DEVELOPMENT_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
