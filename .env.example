# Public browser configuration (publishable values only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Furvise S2B distributed rate limiting (server only; never prefix with NEXT_PUBLIC_)
FURVISE_RATE_LIMIT_ENABLED=true
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-a-dedicated-environment-token
FURVISE_RATE_LIMIT_HASH_SECRET=replace-with-at-least-32-random-characters
FURVISE_RATE_LIMIT_TIMEOUT_MS=800

# Optional bounded overrides (1 to five times the compiled default)
# FURVISE_RATE_LIMIT_ASK_AI_USER_PER_MINUTE=10
# FURVISE_RATE_LIMIT_ASK_AI_IP_PER_MINUTE=30
# FURVISE_RATE_LIMIT_VET_BRIEF_AI_USER_PER_MINUTE=4
# FURVISE_RATE_LIMIT_VET_BRIEF_AI_IP_PER_MINUTE=12

# Furvise S2C AI admission and spending controls (server only)
FURVISE_AI_ENABLED=true
FURVISE_AI_ASK_ENABLED=true
FURVISE_AI_CARE_PLAN_ENABLED=true
FURVISE_AI_PRODUCTS_ENABLED=true
FURVISE_AI_SAFETY_FOLLOWUP_ENABLED=true
FURVISE_AI_VET_BRIEF_ENABLED=true
FURVISE_AI_MEMORY_EXTRACTION_ENABLED=true

# Production values require operator confirmation; requests fail closed when absent.
FURVISE_AI_DAILY_CALL_LIMIT=
FURVISE_AI_DAILY_COST_LIMIT_USD=

# Development-only escape hatches; never enable in preview or production.
# FURVISE_AI_ALLOW_UNKNOWN_MODEL_IN_DEVELOPMENT=false
# FURVISE_AI_ALLOW_UNGUARDED_PROVIDER_IN_DEVELOPMENT=false
